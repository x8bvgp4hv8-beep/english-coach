node_modules/
dist/
dev-dist/
# The component kit's library build, regenerated by `npm run build:kit`.
dist-kit/
# Generated by scripts/sync-content.mjs from the macOS app's resources.
public/content/

# design-sync: staged converter scripts, its build output, and machine-local state.
# Everything else under .design-sync/ (config.json, NOTES.md, conventions.md,
# previews/, overrides/) is committed — it is what makes a re-sync reproducible.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
# The repo root ignores a bare `config.json` (left over from the Python coach), which
# silently swallowed this one. Without it a fresh clone re-syncs with no globalName,
# no card modes and no font config.
!.design-sync/config.json
