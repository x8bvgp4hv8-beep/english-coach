                "a1-questions",
                "a2-past-time-markers"
              ]
            },
            {
              "id": "b1-ch2-l1-ex8",
              "type": "translate",
              "prompt": "Пока я готовил ужин, зазвонил телефон.",
              "canonicalAnswer": "While I was cooking dinner, the phone rang.",
              "acceptedAnswers": [
                "While I was making dinner, the phone rang."
              ],
              "hint": "while + Past Continuous, then Past Simple",
              "difficulty": 3,
              "topics": [
                "b1-past-continuous",
                "b1-while-when"
              ]
            },
            {
              "id": "b1-ch2-l1-ex9",
              "type": "word_order",
              "prompt": "Я читал книгу.",
