              "prompt": "to point out",
              "translation": "указать (на что-то), отметить",
              "example": "She pointed out that we were running late.",
              "difficulty": 1,
              "topics": [
                "b2-reported-speech"
              ]
            },
            {
              "id": "b2-ch3-l1-ex3",
              "type": "multiple_choice",
              "prompt": "She told me that she ___ call me back later.",
              "options": [
                "would",
                "will",
                "is going to"
