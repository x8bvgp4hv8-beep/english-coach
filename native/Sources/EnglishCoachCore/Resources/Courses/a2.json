        {"id":"a2-choice-2","type":"multiple_choice","prompt":"My sister ___ breakfast at home.","options":["have","has","having"],"correctOption":"has"},
        {"id":"a2-translate-3","type":"translate","prompt":"Ты часто готовишь дома?","canonicalAnswer":"Do you often cook at home?","acceptedAnswers":["Do you cook at home often?"]}
