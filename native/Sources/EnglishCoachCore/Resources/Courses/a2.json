        {"id":"a2-card-1","type":"flashcard","prompt":"I usually get up at seven.","translation":"Я обычно встаю в семь.","example":"On weekdays, I usually get up at seven."},
        {"id":"a2-translate-1","type":"translate","prompt":"Я обычно пью кофе утром.","canonicalAnswer":"I usually drink coffee in the morning.","acceptedAnswers":["I normally drink coffee in the morning."],"hint":"usually"},
        {"id":"a2-order-1","type":"word_order","prompt":"Она работает из дома.","canonicalAnswer":"She works from home.","tokens":["from","works","She","home","."]},
        {"id":"a2-choice-1","type":"multiple_choice","prompt":"He ___ to work by bus.","options":["go","goes","going"],"correctOption":"goes"},
        {"id":"a2-card-2","type":"flashcard","prompt":"How often do you exercise?","translation":"Как часто ты тренируешься?","example":"How often do you exercise after work?"},
